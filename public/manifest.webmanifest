{
  "name": "TradingLab",
  "short_name": "TradingLab",
  "description": "Aprende a analizar los mercados sin arriesgar tu dinero. Simulación con USD 10.000 virtuales, academia descargable y análisis educativo con inteligencia artificial.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "lang": "es",
  "dir": "ltr",
  "categories": ["education", "finance"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "/app-icon/192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon/512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon/512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Terminal de simulación",
      "short_name": "Terminal",
      "description": "Practica con dinero virtual",
      "url": "/terminal",
      "icons": [{ "src": "/app-icon/192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Academia",
      "short_name": "Aprender",
      "description": "Tus lecciones, disponibles sin conexión",
      "url": "/academia",
      "icons": [{ "src": "/app-icon/192", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Diario",
      "short_name": "Diario",
      "description": "Registra y revisa tus decisiones",
      "url": "/diario",
      "icons": [{ "src": "/app-icon/192", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
