# ─────────────────────────────────────────────────────────────────────────────
# TradingLab · Plataforma educativa de análisis y simulación de mercados
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al control de versiones.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# El proveedor lo fija `scripts/set-db-provider.mjs` a partir de esta variable,
# y reescribe la línea correspondiente en prisma/schema.prisma. No hay que
# editar el esquema a mano.
DATABASE_PROVIDER="sqlite"

# Desarrollo local (SQLite, sin infraestructura externa):
DATABASE_URL="file:./dev.db"

# Producción (PostgreSQL). Cambia DATABASE_PROVIDER a "postgresql" y usa:
# DATABASE_URL="postgresql://user:password@host:5432/tradinglab?schema=public"
#
# En Firebase App Hosting ambas variables se configuran en apphosting.yaml, y
# DATABASE_URL se guarda en Secret Manager. Ver docs/FIREBASE.md.

# ── Sesiones y criptografía ──────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres-aleatorios"
# Clave para cifrado de campos sensibles en base de datos (32 bytes en base64url)
FIELD_ENCRYPTION_KEY=""

# ── Aplicación ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TradingLab"
NODE_ENV="development"

# ── Inteligencia artificial (OpenAI Responses API) ───────────────────────────
# Si se deja vacío, la plataforma usa el analizador educativo determinístico
# local (`packages/ai/deterministic.ts`). Nunca expongas esta clave al cliente.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MONTHLY_COST_CAP_USD="500"

# ── Proveedores de datos de mercado ──────────────────────────────────────────
# Proveedor activo: synthetic | twelvedata | finnhub
MARKET_DATA_PROVIDER="synthetic"
TWELVEDATA_API_KEY=""
FINNHUB_API_KEY=""
# Latencia declarada del plan contratado, en segundos (0 = tiempo real)
MARKET_DATA_DELAY_SECONDS="0"

# ── Pasarela de suscripciones ────────────────────────────────────────────────
# mock activa planes inmediatamente solo para desarrollo.
# wompi usa Checkout Web y activa el plan únicamente desde el webhook firmado.
BILLING_PROVIDER="mock"
WOMPI_ENVIRONMENT="sandbox"
WOMPI_PUBLIC_KEY=""
# Se reserva para tokenización/cargos API futuros; Checkout Web no la expone.
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_PRICING_MODE="usd_trm"
# Solo con WOMPI_PRICING_MODE=fixed_cop: importes fijos enteros en centavos COP.
# Con usd_trm se usa el catálogo USD y la TRM oficial vigente; no se usan estos importes.
WOMPI_STANDARD_MONTHLY_AMOUNT_IN_CENTS=""
WOMPI_STANDARD_YEARLY_AMOUNT_IN_CENTS=""
WOMPI_PREMIUM_MONTHLY_AMOUNT_IN_CENTS=""
WOMPI_PREMIUM_YEARLY_AMOUNT_IN_CENTS=""

# ── Publicidad ───────────────────────────────────────────────────────────────
# off = apagada | internal = servidor propio | google = AdSense manual
ADS_PROVIDER="internal"
NEXT_PUBLIC_ADS_PROVIDER="internal"
NEXT_PUBLIC_GOOGLE_ADS_ENABLED="false"
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=""
NEXT_PUBLIC_GOOGLE_ADS_TEST_MODE="false"
NEXT_PUBLIC_GOOGLE_AD_SLOT_DASHBOARD_BANNER=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_DASHBOARD_SIDE=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_ACADEMY_FOOTER=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_LESSON_SPONSOR=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_CALENDAR_SPONSOR=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_NEWS_NATIVE=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_PUBLIC_BANNER=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_CHALLENGE_SPONSOR=""
NEXT_PUBLIC_GOOGLE_AD_SLOT_WEEKLY_REPORT_SPONSOR=""
# HMAC de recibos del motor interno. Con menos de 32 caracteres no se sirve inventario.
ADS_EVENT_TOKEN_SECRET=""
# Reservado para una futura integración separada con Google Ad Manager.
GOOGLE_AD_MANAGER_NETWORK_CODE=""

# ── Correo ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@tradinglab.example"
RESEND_API_KEY=""

# ── Observabilidad ───────────────────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"

# ── Cumplimiento ─────────────────────────────────────────────────────────────
# Códigos ISO-3166 alfa-2 separados por coma donde no se ofrece el servicio.
RESTRICTED_COUNTRIES=""
MIN_AGE_DEFAULT="18"
